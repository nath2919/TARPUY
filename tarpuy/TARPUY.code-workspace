{
  "folders": [{"path": "."}],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "TARPUY · Chrome (requiere servidor NASA)",
        "type": "dart",
        "request": "launch",
        "program": "lib/main.dart",
        "deviceId": "chrome",
        "toolArgs": ["--web-port", "8080", "--dart-define=POWER_PROXY=http://localhost:8787/api/power"]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "TARPUY: iniciar servidor NASA",
        "type": "shell",
        "command": "dart run server/server.dart",
        "options": {"cwd": "${workspaceFolder}"},
        "problemMatcher": []
      }
    ]
  }
}
