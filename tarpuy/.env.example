# No credentials required for NASA POWER or OpenStreetMap.
# PowerShell runtime: $env:PORT='8787'; dart run server/server.dart
PORT=8787
# Flutter compile-time setting, passed with --dart-define (not auto-loaded):
# POWER_PROXY=http://localhost:8787/api/power
# Defaults to /api/power for the integrated build served by Dart.

# Future Supabase integration only. Not consumed by this MVP.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Keep any Earthdata or AI provider secrets on the server only.
# No AI provider or Earthdata authentication implemented yet.
